# Edit before the first run. All values below match README.md defaults.

# --- Application identity ---
PROJECT_NAME=themaximus
NAMESPACE=themaximus
APP_HOST=themaximus.lab.local
REPLICAS=3

# --- Nexus registry ---
NEXUS_REGISTRY=192.168.2.128:8082
NEXUS_REPO=themaximus
# FULL_IMAGE is derived by the Jenkinsfile as: NEXUS_REGISTRY/NEXUS_REPO:BUILD_NUMBER

# --- Kubernetes ---
INGRESS_CLASS=nginx
KUBE_INGRESS_IP=192.168.2.130

# --- SonarQube ---
SONAR_PROJECT_KEY=themaximus
SONAR_SERVER_NAME=SonarQube-Server

# --- Technitium DNS ---
TECHNITIUM_API_URL=http://192.168.2.120:5380/api
TECHNITIUM_ZONE=lab.local
NPM_IP=192.168.2.129

# --- Nginx Proxy Manager ---
NPM_API_URL=http://192.168.2.129:81/api
NPM_FORWARD_IP=192.168.2.130
NPM_FORWARD_PORT=80
